  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.Test_Streams" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
