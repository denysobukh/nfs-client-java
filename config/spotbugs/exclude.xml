      <Method name="testReadingAndWriting" />
    </Or>
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Test_CustomPorts$Peer" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Method name="await" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Test_MountDiagnostics$Peer" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Method name="await" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Test_Nfs3" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
      <Method name="testGetRootHandle" />
      <Method name="testSetAttrGuarded" />
    </Or>
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.rpc.Test_RpcDiagnostics" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
      <Method name="knownStatusesIncludeSymbolicNameAndCode" />
      <Method name="missingFileRemainsFileNotFoundExceptionWithEndpoint" />
      <Method name="nfsStatusFailuresHaveEndpointAndPreserveStatusWithoutRetry" />
      <Method name="retriesIdentifyOperationAndKeepTerminalCause" />
    </Or>
  </Match>
  <!-- NfsSetAttributes is a mutable request builder, deliberately shared until marshalling. Callers must finish configuring it before sending the request. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsCreateRequest" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_attributes" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsMkdirRequest" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_attributes" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsMknodRequest" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_attributes" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsSetAttrRequest" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_attributes" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsSymlinkRequest" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_attributes" />
  </Match>
  <!-- Only the root-handle reference is replaced during remount. Each published array is privately cloned and never modified; getters return clones, so volatile element updates are unnecessary. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Nfs3" />
    <Bug pattern="VO_VOLATILE_REFERENCE_TO_ARRAY" />
    <Field name="_rootFileHandle" />
  </Match>
  <!-- READ explicitly fills the caller-provided destination buffer; copying it would discard the result visible to the caller. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsReadResponse" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_bytes" />
  </Match>
  <!-- READDIR and READDIRPLUS explicitly append into the caller-provided list across response pages. getEntries returns that same accumulator by contract. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsReaddirResponse" />
    <Bug pattern="EI_EXPOSE_REP" />
    <Field name="_entries" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsReaddirResponse" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_entries" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsReaddirplusResponse" />
    <Bug pattern="EI_EXPOSE_REP" />
    <Field name="_entries" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsReaddirplusResponse" />
    <Bug pattern="EI_EXPOSE_REP2" />
    <Field name="_entries" />
  </Match>
  <!-- Response handlers are created for one synchronous RPC and do not escape the call; test fixtures live only for the test. Their enclosing references do not create a long-lived retention leak. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.Test_NfsCompatibility" />
    <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON" />
    <Method name="oldImplementationCompilesUnchangedAndItsOldBytecodeUsesTheDefaultMethod" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.Test_Nfs3File" />
    <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON" />
    <Method name="testDirectoryReading" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.Test_StreamDiagnostics" />
    <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON" />
    <Method name="suppressedCloseFailureWarnsAboutBufferedDataAndFile" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Nfs3" />
    <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON" />
    <Or>
      <Method name="nullCall" />
      <Method name="read" />
      <Method name="wrapped_getAccess" />
      <Method name="wrapped_getAttr" />
      <Method name="wrapped_getFsInfo" />
      <Method name="wrapped_getFsStat" />
      <Method name="wrapped_getPathconf" />
      <Method name="wrapped_getRead" />
      <Method name="wrapped_getReaddir" />
      <Method name="wrapped_getReaddirplus" />
      <Method name="wrapped_getReadlink" />
      <Method name="wrapped_sendCommit" />
      <Method name="wrapped_sendCreate" />
      <Method name="wrapped_sendLink" />
      <Method name="wrapped_sendMkdir" />
      <Method name="wrapped_sendMknod" />
      <Method name="wrapped_sendRemove" />
      <Method name="wrapped_sendRename" />
      <Method name="wrapped_sendRmdir" />
      <Method name="wrapped_sendSymlink" />
      <Method name="wrapped_sendWrite" />
      <Method name="wrapped_setAttr" />
    </Or>
  </Match>
  <!-- The private per-operation callback is passed only to callRpcWrapped with its corresponding LOOKUP or WRITE request in the immediately enclosing method. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Nfs3$4" />
    <Bug pattern="BC_UNCONFIRMED_CAST" />
    <Method name="checkResponse" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Nfs3$9" />
    <Bug pattern="BC_UNCONFIRMED_CAST" />
    <Method name="checkResponse" />
  </Match>
  <!-- These are shared client/file collaborators, not owned value objects. Identity and live shared state are required for I/O, parent navigation, and symbolic-link resolution. -->
