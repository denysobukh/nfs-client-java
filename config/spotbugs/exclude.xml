<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Reviewed exceptions only. Do not add a baseline or disable entire bug categories. -->
  <!-- Decoded RFC 1813 fields are part of the public result API and are consumed by library users even when this repository does not read them. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsFsInfo" />
    <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD" />
    <Field name="properties" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsFsStat" />
    <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD" />
    <Field name="ffiles" />
  </Match>
  <!-- Executor Runnable test peers cannot declare checked failures. They wrap I/O/interruption failures so Future.get fails the test with the original cause. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.network.Test_NettyTransport" />
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Or>
      <Method name="lambda$rpcTimeoutIdentifiesRequestAndEndpoint$0" />
      <Method name="lambda$tcpRoundTripAndDisconnect$0" />
    </Or>
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Test_CustomPorts$Peer" />
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Method name="lambda$new$0" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Test_MountDiagnostics$Peer" />
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Method name="lambda$new$0" />
  </Match>
  <!-- Existing public accessors belong to different protocol holder types. Preserve their spelling for source and binary compatibility. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsDirectoryEntry" />
    <Bug pattern="NM_CONFUSING" />
    <Method name="getFileId" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.NfsGetAttributes" />
    <Bug pattern="NM_CONFUSING" />
    <Or>
      <Method name="getCtime" />
      <Method name="getMtime" />
    </Or>
  </Match>
  <!-- Intentional extension hooks: NfsFileBase creates the concrete parent-file type, and Nfs3 supports overriding service discovery. Existing subclasses and local peer tests rely on construction invoking these hooks; implementations must not depend on uninitialized subclass fields. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.NfsFileBase" />
    <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR" />
    <Method name="&lt;init&gt;" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.nfs3.Nfs3" />
    <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR" />
    <Method name="&lt;init&gt;" />
  </Match>
  <!-- JUnit test entry points and peer await helpers intentionally propagate checked failures to the runner so their original causes fail the test. -->
  <Match>
    <Class name="com.emc.ecs.nfsclient.network.Test_NettyTransport" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
      <Method name="channelFailureIsLoggedAndPreservesOriginalThrowable" />
      <Method name="failedConnectUnblocksSender" />
      <Method name="rpcTimeoutIdentifiesRequestAndEndpoint" />
      <Method name="tcpRoundTripAndDisconnect" />
    </Or>
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.Test_NfsCompatibility" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Method name="oldImplementationCompilesUnchangedAndItsOldBytecodeUsesTheDefaultMethod" />
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.Test_LoadTest" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
      <Method name="testThreadedReadingPerformance100MB" />
      <Method name="testThreadedReadingPerformance10MB" />
      <Method name="testThreadedReadingPerformance1MB" />
      <Method name="testThreadedReadingPerformance500kB" />
    </Or>
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.Test_Nfs3File" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
    <Or>
      <Method name="testAttributeSettingAndGetting" />
      <Method name="testDirectoryReading" />
      <Method name="testFileAndDirectoryCreationAndDeletion" />
      <Method name="testLinkHandling" />
      <Method name="testSpecialHandling" />
    </Or>
  </Match>
  <Match>
    <Class name="com.emc.ecs.nfsclient.nfs.io.Test_StreamDiagnostics" />
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
